# Copie para .env e ajuste conforme necessário.
# NUNCA coloque ACCESS_TOKEN / COOKIE_HEADER aqui — eles ficam em
# secrets.env (gerado por `meligpt import-har`), fora do controle de versão
# e fora da imagem Docker.

# --- Diretórios --------------------------------------------------------
MELIGPT_CONFIG_DIR=/data/config
MELIGPT_FILES_DIR=/data/files
MELIGPT_SECRETS_PATH=/data/config/secrets.env

# --- Limites -------------------------------------------------------------
MELIGPT_MAX_FILE_SIZE=1048576
MELIGPT_MAX_LS_RESULTS=1000
MELIGPT_MAX_DISCOVERY_RESULTS=20
MELIGPT_MAX_CONTEXT_SIZE=4194304
MELIGPT_MAX_CONTEXT_FILES=200
MELIGPT_MAX_GREP_RESULTS=500
MELIGPT_MAX_GREP_BYTES_PER_FILE=1048576
MELIGPT_MAX_GLOB_RESULTS=1000

# --- Busca web (ferramenta WebSearch) --------------------------------------
# Cadastre-se em https://brave.com/search/api/ (tem tier gratuito).
MELIGPT_WEB_SEARCH_PROVIDER=brave
MELIGPT_BRAVE_API_KEY=
MELIGPT_WEB_SEARCH_MAX_RESULTS=5

# Alternativa experimental (não testada ao vivo): liga o campo nativo
# "browsing" do payload do MeliGPT, que pode dar busca feita pelo próprio
# modelo remoto sem depender do Brave. Ver docs/tools.md.
MELIGPT_ENABLE_BROWSING=false

# --- API upstream --------------------------------------------------------
MELIGPT_BASE_URL=https://public-meligpt.adminml.com
MELIGPT_MODEL=gpt-5.6-sol
MELIGPT_CONNECT_TIMEOUT_SECONDS=20
MELIGPT_READ_TIMEOUT_SECONDS=600

# --- Servidor HTTP/SSE opcional ------------------------------------------
MELIGPT_SERVER_HOST=0.0.0.0
MELIGPT_SERVER_PORT=8080
MELIGPT_LOG_LEVEL=INFO

# --- Refresh automático de token ------------------------------------------
# Mantém o access token vivo sozinho enquanto `meligpt serve` estiver
# rodando, usando o refreshToken já salvo (sem precisar reimportar HAR).
MELIGPT_AUTO_REFRESH_ENABLED=true
MELIGPT_TOKEN_REFRESH_MARGIN_SECONDS=120
MELIGPT_TOKEN_REFRESH_INTERVAL_SECONDS=600
