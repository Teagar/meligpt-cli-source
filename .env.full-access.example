# Preset "tudo liberado" para uso 100% LOCAL — `meligpt serve` rodando na
# MESMA máquina onde o OpenClaude roda, fora de um container isolado.
#
# ⚠️ Isso dá ao modelo remoto (via OpenClaude) execução real de comando e
# leitura/escrita irrestrita no seu filesystem real. Só use em máquina
# pessoal/dev, nunca num servidor compartilhado ou exposto à rede.
#
# Uso:
#   cp .env.full-access.example .env
#   meligpt serve
#
# Depois, no OpenClaude, aponte a base URL do provider para este servidor
# (ex.: http://localhost:8080/v1) e rode:
#   openclaude --permission-mode acceptEdits
# (ou --dangerously-skip-permissions, se quiser zero prompts de confirmação
# — só em ambiente isolado/que você controla).

# --- Diretórios --------------------------------------------------------
MELIGPT_CONFIG_DIR=/data/config
MELIGPT_SECRETS_PATH=/data/config/secrets.env

# Modo "passagem direta": ls/read_file/write_file/edit_file/glob/grep
# operam no filesystem REAL da máquina, não num sandbox isolado.
MELIGPT_FILES_DIR=/
MELIGPT_ALLOW_FULL_FILESYSTEM_ACCESS=true

# Imagens geradas (ver seção "Geração de imagens" do README) ficam SEMPRE
# em MELIGPT_CONFIG_DIR/generated-images, independente de MELIGPT_FILES_DIR
# — mesmo com FILES_DIR=/ acima, não tenta gravar na raiz real do
# filesystem (isso exigiria root e falharia). Só descomente para
# sobrescrever o destino padrão.
# MELIGPT_MEDIA_DIR=/data/config/generated-images

# --- Ferramenta bash (execução real de comando) ----------------------------
# Ligada de propósito neste preset. Fora de um container isolado, isso
# equivale a dar acesso de shell à sua máquina para o modelo remoto.
MELIGPT_ENABLE_BASH_TOOL=true
MELIGPT_BASH_TIMEOUT_SECONDS=60
MELIGPT_BASH_MAX_OUTPUT_BYTES=500000

# --- Limites (ajustados um pouco acima do default para uso local) --------
MELIGPT_MAX_FILE_SIZE=5242880
MELIGPT_MAX_LS_RESULTS=2000
MELIGPT_MAX_DISCOVERY_RESULTS=40
MELIGPT_MAX_CONTEXT_SIZE=8388608
MELIGPT_MAX_CONTEXT_FILES=400
MELIGPT_MAX_GREP_RESULTS=1000
MELIGPT_MAX_GREP_BYTES_PER_FILE=2097152
MELIGPT_MAX_GLOB_RESULTS=2000

# --- Busca web (ferramenta WebSearch) --------------------------------------
# Opcional — deixe MELIGPT_BRAVE_API_KEY vazio se não quiser configurar.
MELIGPT_WEB_SEARCH_PROVIDER=brave
MELIGPT_BRAVE_API_KEY=
MELIGPT_WEB_SEARCH_MAX_RESULTS=5

# --- API upstream --------------------------------------------------------
MELIGPT_BASE_URL=https://public-meligpt.adminml.com
MELIGPT_MODEL=gpt-5.6-sol
MELIGPT_CONNECT_TIMEOUT_SECONDS=20
MELIGPT_READ_TIMEOUT_SECONDS=600

# --- Catálogo de modelos multi-provedor ------------------------------------
# MELIGPT_MODELS_URL=
MELIGPT_MODELS_CACHE_SECONDS=300

# --- Servidor HTTP/SSE ------------------------------------------------------
MELIGPT_SERVER_HOST=0.0.0.0
MELIGPT_SERVER_PORT=8080
MELIGPT_LOG_LEVEL=INFO

# --- Refresh automático de token ------------------------------------------
MELIGPT_AUTO_REFRESH_ENABLED=true
MELIGPT_TOKEN_REFRESH_MARGIN_SECONDS=120
MELIGPT_TOKEN_REFRESH_INTERVAL_SECONDS=600
